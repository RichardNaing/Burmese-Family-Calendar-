{
  "expo": {
    "name": "Burmese Calendar",
    "slug": "burmese-calendar",
    "scheme": "burmesecalendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Myanmar calendar: Burmese dates, full moon and Sabbath days, official public holidays.",
    "ios": {
      "bundleIdentifier": "com.itgardenmalaysia.burmesecalendar",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.itgardenmalaysia.burmesecalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EFEDE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#B3261E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#EFEDE7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/Burmese-Family-Calendar-/app"
    },
    "backgroundColor": "#EFEDE7"
  }
}
